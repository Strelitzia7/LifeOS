{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schema/daily-plan-1.0.json",
  "title": "LifeOS Daily Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "plan_id", "date", "tasks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "type": { "const": "daily_plan" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "maxLength": 200 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "start_time", "end_time"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "start_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "end_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "category": { "type": "string", "maxLength": 80 },
          "status": { "enum": ["planned", "in_progress", "completed", "skipped", "cancelled"] }
        }
      }
    }
  },
  "description": "任务 ID 唯一性、结束时间晚于开始时间及任务间不重叠由 Zod 运行时规则补充验证。"
}
